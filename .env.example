# Copy to .env for local development. On Vercel, set these in Project Settings -> Environment Variables.

# --- AI (at least one; the app still works with none, using the offline engine) ---
GEMINI_API_KEY=
# Tried in order. A model is skipped only when it errors, never because it is slow.
GROQ_API_KEY=
# Models to try, in order (provider:model). Picked with: python scripts/benchmark_models.py --file my_resume.pdf
AI_CHAIN=groq:qwen/qwen3.8-27b,gemini:gemini-3.1-flash-lite,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-20b
# Only used when someone adds their own Gemini key in Settings
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite

# --- Accounts & storage (optional; without these everyone uses guest mode) ---
# Use the new keys (sb_publishable_... / sb_secret_...) or the legacy anon / service_role keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Security ---
# Comma-separated list of sites allowed to call the API from another origin (same-origin always works).
ALLOWED_ORIGINS=http://localhost:5173
# Any long random string; used to anonymise guest IPs for rate limits.
IP_HASH_SALT=change-me-to-a-long-random-string

# --- Timing (seconds). Slow AI is never cut off while it is still sending. ---
AI_STALL_SECONDS=45
AI_GEMINI_BUDGET_SECONDS=120
AI_GROQ_BUDGET_SECONDS=40
AI_TOTAL_DEADLINE_SECONDS=285

# --- Daily AI limits per person ---
LIMIT_GUEST_TAILOR=5
LIMIT_USER_TAILOR=25
LIMIT_GUEST_REWRITE=20
LIMIT_USER_REWRITE=150
LIMIT_GUEST_PARSE=3
LIMIT_USER_PARSE=10
